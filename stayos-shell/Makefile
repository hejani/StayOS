# Makefile - StayOS Shell Build & Deploy
#
# The shell is static assets served from the ROOT of the shared StayOS S3 bucket
# + CloudFront distribution owned by LUMI (LUMI at /lumi/, PULSE at /pulse/, the
# shell at "/"). It has no infrastructure of its own. This Makefile generates the
# shell's build-time Cognito config from the LUMI stack outputs, builds the static
# export, syncs it to the bucket root, and invalidates the root cache entries.
#
# Prerequisites: AWS CLI v2, Node.js 18+. Deploy is manual (run after LUMI's
# stack exists, since it reads LUMI's Cognito + bucket + distribution).
#
# Usage:
#   make deploy                          # uses current AWS profile account
#   make deploy ACCOUNT_ID=123456789012  # explicit account

STACK_PREFIX ?= stayos
AWS_PROFILE ?=
export AWS_PROFILE
ACCOUNT_ID ?= $(shell AWS_PROFILE=$(AWS_PROFILE) aws sts get-caller-identity --query Account --output text 2>/dev/null)
REGION ?= $(shell AWS_PROFILE=$(AWS_PROFILE) aws configure get region 2>/dev/null || echo us-east-1)
STACK_NAME := $(STACK_PREFIX)-$(REGION)
FRONTEND_BUCKET := $(STACK_PREFIX)-frontend-$(ACCOUNT_ID)

.PHONY: all deploy write-frontend-env build-frontend deploy-frontend \
        invalidate-cdn test test-frontend lint clean

all: deploy

# Full shell deploy: config -> build -> sync to bucket root -> invalidate "/".
deploy: write-frontend-env build-frontend deploy-frontend invalidate-cdn
	@echo ""
	@echo "══════════════════════════════════════════════════════════════"
	@echo "  StayOS shell deployment complete"
	@echo "  Served at the site root of the shared StayOS distribution"
	@echo "══════════════════════════════════════════════════════════════"

# ─── Step 1: Generate frontend config from the LUMI stack outputs ─────────────
# The shell authenticates against the SAME Cognito user pool + app client as LUMI
# and PULSE, so the issued session is valid across all three (SSO). Pull the
# client ID from the shared stack; region is the deploy region.
write-frontend-env:
	@echo "[1/4] Generating shell config from stack outputs..."
	@CLIENT_ID=$$(aws cloudformation describe-stacks \
		--stack-name $(STACK_NAME) \
		--query "Stacks[0].Outputs[?OutputKey=='UserPoolClientId'].OutputValue" \
		--output text) && \
	printf '%s\n' \
		"# Auto-generated by make deploy - do not edit manually" \
		"NEXT_PUBLIC_COGNITO_CLIENT_ID=$$CLIENT_ID" \
		"NEXT_PUBLIC_COGNITO_REGION=$(REGION)" \
		> frontend/.env.production
	@echo "    done"

# ─── Step 2: Build the static export ──────────────────────────────────────────
build-frontend:
	@echo "[2/4] Building shell frontend..."
	@cd frontend && npm ci --legacy-peer-deps --silent 2>/dev/null && npm run build > /dev/null 2>&1
	@echo "    done"

# ─── Step 3: Deploy to the bucket ROOT ────────────────────────────────────────
# The shell owns the site root. Sync its export to the bucket root. NOTE: no
# --delete here - a blanket delete at the root would remove the /lumi/ and
# /pulse/ feature assets. The shell's own files are overwritten in place; stale
# top-level shell files are rare and cleaned manually if ever needed.
deploy-frontend:
	@echo "[3/4] Deploying shell to S3 (bucket root)..."
	@aws s3 sync frontend/out/ s3://$(FRONTEND_BUCKET)/ --exclude "lumi/*" --exclude "pulse/*" --quiet
	@echo "    done"

# ─── Step 4: Invalidate the root cache entries ────────────────────────────────
# Invalidate the shell's entry points only (root + top-level export files), not
# /lumi/* or /pulse/*, so a shell redeploy does not churn the feature caches.
invalidate-cdn:
	@echo "[4/4] Invalidating CDN cache (shell root)..."
	@aws cloudfront create-invalidation \
		--distribution-id $$(aws cloudformation describe-stacks \
			--stack-name $(STACK_NAME) \
			--query "Stacks[0].Outputs[?OutputKey=='FrontendDistributionId'].OutputValue" \
			--output text) \
		--paths "/" "/index.html" "/_next/*" "/favicon.svg" "/logo.svg" > /dev/null
	@echo "    done"

# ─── Testing / lint ───────────────────────────────────────────────────────────
test: test-frontend
	@echo "All tests passed"

test-frontend:
	@echo "Running shell frontend tests..."
	@cd frontend && npm run test:run

lint:
	@echo "Linting shell frontend..."
	@cd frontend && npm run lint

clean:
	@rm -rf frontend/.next frontend/out
